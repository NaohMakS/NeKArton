  nodes:
  - speaker: Главный герой
    text: "Привет. Ты знаешь, где мы? Я, кажется, потерялся."
    next: 1
    endsHere: 0
    choices: []
  - speaker: Настя
    text: "Ты наконец очнулся. Я уже начала думать, что ты не придёшь в себя."
    next: 2
    endsHere: 0
    choices: []
  - speaker: Главный герой
    text: "Кто ты? И что это за место?"
    next: 3
    endsHere: 0
    choices: []
  - speaker: Настя
    text: "Меня зовут Настя. Давай поговорим спокойно — у меня к тебе тоже много вопросов."
    next: -1
    endsHere: 1
    choices: []
