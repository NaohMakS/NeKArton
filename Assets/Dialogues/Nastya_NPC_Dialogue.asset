  m_Script: {fileID: 11500000, guid: 4f3bde62e1c950945aca324b1d32a62b, type: 3}
  m_Name: Nastya_NPC_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  nodes:
  - speaker: Nastya_NPC
    text: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0422\u044B \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C?"
    next: -1
    endsHere: 0
    choices:
    - text: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E!"
      next: 1
    - text: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441."
      next: 2
  - speaker: Nastya_NPC
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u0417\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u043D\u0430 \u0442\u0435\u0431\u044F \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C\u0441\u044F."
    next: -1
    endsHere: 1
    choices: []
  - speaker: Nastya_NPC
    text: "\u041B\u0430\u0434\u043D\u043E, \u0437\u0430\u0445\u043E\u0434\u0438 \u043F\u043E\u0442\u043E\u043C."
    next: -1
    endsHere: 1
    choices: []
