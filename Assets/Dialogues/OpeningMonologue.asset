  m_Script: {fileID: 11500000, guid: 4f3bde62e1c950945aca324b1d32a62b, type: 3}
  m_Name: OpeningMonologue
  m_EditorClassIdentifier:
  nodes:
  - speaker: Главный герой
    text: "Где... я? Последнее, что я помню, — как шёл домой. Как я оказался здесь?"
    next: 1
    endsHere: 0
    choices: []
  - speaker: Главный герой
    text: "Нужно осмотреться. Комната выглядит жилой, но вокруг слишком тихо."
    next: 2
    endsHere: 0
    choices: []
  - speaker: Главный герой
    text: "Подожди... Там кто-то есть. Кажется, она тоже меня заметила."
    next: -1
    endsHere: 1
    choices: []
